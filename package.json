{
  "name": "bixcel-lms",
  "version": "1.0.0",
  "description": "Full-Stack Learning Management System with React 19 and CodeIgniter 4 PHP",
  "scripts": {
    "dev": "concurrently -n \"CI4-BACKEND,REACT-FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "php -S localhost:8080 -t backend/public",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "react",
    "codeigniter4",
    "php",
    "lms",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
